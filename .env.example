# llama.cpp Docker Compose — environment variables
# Copy to .env and fill in before starting:
#   cp .env.example .env

# API key for the llama.cpp server — must match LLAMACPP_API_KEY in dsh-home/.credentials.yaml
# No default is provided for security; generate a random key or use your org's secret manager.
LLAMACPP_API_KEY=

# Host port for the HTTP API (container always listens on 8080)
# Default 8081 avoids conflicts with common services on 8080 (Docker Registry, Prometheus, etc.)
LLAMACPP_PORT=8081
